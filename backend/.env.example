# For local smoke of /runtime/* you can point at any Postgres.
# Full auth/agent DB features need Postgres (Railway).
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/bhudi
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
REFRESH_TOKEN_HASH_KEY=change-me-refresh-hash-key
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
