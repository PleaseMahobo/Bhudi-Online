# For local smoke of /runtime/* you can point at any Postgres.
# Full auth/agent DB features need Postgres (Railway).
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/bhudi
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
REFRESH_TOKEN_HASH_KEY=change-me-refresh-hash-key
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# SMTP — scheduled report email delivery
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=reports@example.com
SMTP_FROM_NAME=Bhudi Reports
SMTP_TIMEOUT=30
# Retry transient SMTP failures (connection drops, 4xx, timeouts)
SMTP_MAX_RETRIES=3
SMTP_RETRY_BASE_DELAY=1.0
SMTP_RETRY_MAX_DELAY=30.0

# Stripe — MSP billing webhooks
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_STORE_PAYLOAD=true
