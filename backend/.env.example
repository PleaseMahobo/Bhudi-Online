# For local smoke of /runtime/* you can point at any Postgres.
# Full auth/agent DB features need Postgres (Railway).
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/bhudi
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
REFRESH_TOKEN_HASH_KEY=change-me-refresh-hash-key
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# Transactional email — recommended for Railway/Hobby because it uses HTTPS/443.
# Create a verified sending domain and API key with your email provider.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_URL=https://api.resend.com/emails
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_DELAY=1.0
EMAIL_RETRY_MAX_DELAY=30.0
EMAIL_HTTP_TIMEOUT=30

# Sender identity used by the transactional provider.
SMTP_FROM_EMAIL=security@bhudi.online
SMTP_FROM_NAME=Bhudi RMM

# Legacy SMTP — only use when the deployment environment permits outbound SMTP.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=30
SMTP_MAX_RETRIES=3
SMTP_RETRY_BASE_DELAY=1.0
SMTP_RETRY_MAX_DELAY=30.0

# Password reset links
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_SECRET=change-me-to-a-different-long-random-secret
PASSWORD_RESET_EXPIRE_MINUTES=60
PASSWORD_RESET_ISSUER=bhudi-api
PASSWORD_RESET_AUDIENCE=bhudi-password-reset

# Stripe — MSP billing webhooks
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_STORE_PAYLOAD=true
