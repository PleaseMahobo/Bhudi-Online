<?xml version="1.0" encoding="UTF-8"?>
<!-- Native Bhudi Agent MSI — no Python required on target PCs -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="Bhudi Agent"
      Manufacturer="Bhudi"
      Version="2.0.0"
      UpgradeCode="6dcaacf5-f55a-49b5-8632-893587bd4ec3"
      Scope="perMachine"
      Language="1033">

    <SummaryInformation
        Description="Bhudi native RMM agent (standalone — no Python required)"
        Manufacturer="Bhudi" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of Bhudi Agent is already installed."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="SERVERURL" Value="https://bhudi-online-production.up.railway.app" />

    <Feature Id="MainFeature" Title="Bhudi Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <CustomAction
        Id="InstallBhudiAgent"
        Directory="INSTALLFOLDER"
        ExeCommand="[INSTALLFOLDER]bhudi-agent.exe install -server [SERVERURL]"
        Execute="deferred"
        Impersonate="no"
        Return="check" />

    <InstallExecuteSequence>
      <Custom Action="InstallBhudiAgent" After="InstallFiles" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Bhudi Agent" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="AgentExeComponent" Guid="9eca2463-ce95-489e-bdf4-f435a5d9d969">
        <File
            Id="BhudiAgentExe"
            Source="!(bindpath.agent)bhudi-agent.exe"
            KeyPath="yes"
            Checksum="yes" />
        <Shortcut
            Id="StartMenuShortcut"
            Directory="ProgramMenuFolder"
            Name="Bhudi Agent"
            Description="Bhudi RMM Agent"
            Target="[INSTALLFOLDER]bhudi-agent.exe"
            Arguments="run"
            WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RegistryValue
            Root="HKLM"
            Key="Software\Bhudi\Agent"
            Name="InstallPath"
            Type="string"
            Value="[INSTALLFOLDER]"
            KeyPath="no" />
      </Component>
    </ComponentGroup>
  </Package>
</Wix>
