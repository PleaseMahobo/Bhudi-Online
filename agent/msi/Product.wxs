<?xml version="1.0" encoding="UTF-8"?>
<!-- Native Bhudi Agent MSI — generic deployment package; customer-specific enrollment is performed by the portal EXE. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="Bhudi Agent"
      Manufacturer="Bhudi"
      Version="2.0.1"
      UpgradeCode="6dcaacf5-f55a-49b5-8632-893587bd4ec3"
      Scope="perMachine"
      Language="1033">

    <SummaryInformation
        Description="Bhudi native RMM agent — generic MSI deployment package"
        Manufacturer="Bhudi" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of Bhudi Agent is already installed."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="SERVERURL" Value="https://bhudi-online-production.up.railway.app" />

    <Feature Id="MainFeature" Title="Bhudi Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Bhudi Agent" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="AgentExeComponent" Guid="9eca2463-ce95-489e-bdf4-f435a5d9d969">
        <File
            Id="BhudiAgentExe"
            Source="!(bindpath.agent)bhudi-agent.exe"
            KeyPath="yes"
            Checksum="yes" />

        <!--
          The MSI is intentionally a generic deployment package. It has no
          customer enrollment secret, so it must NOT attempt to start the
          agent during installation. Customer-specific automatic enrollment
          is performed by BhudiAgent-Setup.exe, which embeds a single-use
          tenant-bound enrollment bootstrap.
        -->
        <ServiceInstall
            Id="BhudiAgentService"
            Name="BhudiAgent"
            DisplayName="Bhudi Agent"
            Description="Bhudi RMM agent — heartbeats, remote access, and support operations."
            Type="ownProcess"
            Start="demand"
            Account="LocalSystem"
            ErrorControl="normal"
            Arguments="run -server [SERVERURL]"
            Vital="yes" />

        <ServiceControl
            Id="BhudiAgentServiceControl"
            Name="BhudiAgent"
            Stop="both"
            Remove="uninstall"
            Wait="yes" />

        <Shortcut
            Id="StartMenuShortcut"
            Directory="ProgramMenuFolder"
            Name="Bhudi Agent"
            Description="Bhudi RMM Agent"
            Target="[INSTALLFOLDER]bhudi-agent.exe"
            Arguments="run"
            WorkingDirectory="INSTALLFOLDER" />

        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RegistryValue
            Root="HKLM"
            Key="Software\Bhudi\Agent"
            Name="InstallPath"
            Type="string"
            Value="[INSTALLFOLDER]"
            KeyPath="no" />
      </Component>
    </ComponentGroup>
  </Package>
</Wix>
