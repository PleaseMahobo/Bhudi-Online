<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bhudi Agent — enterprise per-machine MSI (WiX Toolset 3.14+)
  Build:
    candle -dAgentDir=..\native\dist Product.wxs
    light -ext WixUIExtension Product.wixobj -out bhudi-agent-setup.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Bhudi Agent"
      Language="1033"
      Version="2.1.0"
      Manufacturer="Bhudi / Cyber Bastion"
      UpgradeCode="6DCAACF5-F55A-49B5-8632-893587BD4EC3"
      InstallerVersion="500"
      Compressed="yes"
      Scope="perMachine">


    <MajorUpgrade
        DowngradeErrorMessage="A newer version of Bhudi Agent is already installed. Remove it first."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="SERVERURL" Secure="yes" Value="https://bhudi-online-production.up.railway.app" />

    <Feature Id="ProductFeature" Title="Bhudi Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="COMPANYDIR" Name="Bhudi">
          <Directory Id="INSTALLFOLDER" Name="Agent" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Bhudi Agent" />
      </Directory>
    </Directory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="AgentBinary" Guid="9ECA2463-CE95-489E-BDF4-F435A5D9D969">
        <File
            Id="BhudiAgentExe"
            Name="bhudi-agent.exe"
            Source="$(var.AgentDir)\bhudi-agent.exe"
            KeyPath="yes"
            Checksum="yes" />

        <ServiceInstall
            Id="BhudiAgentServiceInstall"
            Name="BhudiAgent"
            DisplayName="Bhudi Agent"
            Description="Bhudi RMM agent — monitoring, remote access, and command execution."
            Type="ownProcess"
            Start="auto"
            Account="LocalSystem"
            ErrorControl="normal"
            Arguments="run -server [SERVERURL]"
            Vital="yes" />

        <ServiceControl
            Id="BhudiAgentServiceControl"
            Name="BhudiAgent"
            Start="install"
            Stop="both"
            Remove="uninstall"
            Wait="yes" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\BhudiAgent" Name="DisplayName" Value="Bhudi Agent" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\BhudiAgent" Name="Publisher" Value="Bhudi / Cyber Bastion" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\BhudiAgent" Name="DisplayVersion" Value="2.1.0" Type="string" />
      </Component>

      <Component Id="StartMenuShortcut" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
        <Shortcut
            Id="BhudiAgentShortcut"
            Directory="ApplicationProgramsFolder"
            Name="Bhudi Agent"
            Description="Run Bhudi Agent (foreground)"
            Target="[INSTALLFOLDER]bhudi-agent.exe"
            Arguments="run"
            WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Bhudi\Agent" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Package>
</Wix>
