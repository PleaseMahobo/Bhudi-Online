{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "rmm.example.com" }],
      "destination": "/deep-buddy"
    },
    {
      "source": "/console",
      "has": [{ "type": "host", "value": "rmm.example.com" }],
      "destination": "/deep-buddy/console"
    },
    {
      "source": "/console/:path*",
      "has": [{ "type": "host", "value": "rmm.example.com" }],
      "destination": "/deep-buddy/console/:path*"
    }
  ]
}
