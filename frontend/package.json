    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.41.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.21.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/node": "^22",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "prisma": "^5.22.0",
