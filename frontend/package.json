{
  "name": "bhudi-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "next build",
    "build:turbo": "next build --turbopack",
    "build:analyze": "ANALYZE=true next build",
